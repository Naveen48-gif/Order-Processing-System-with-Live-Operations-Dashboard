# ---------------------------------------------------------------------------
# Order Processing System - environment template.
# Copy to .env (git-ignored) and adjust. Never commit real credentials.
#   cp .env.example .env
# Docker Compose picks this file up automatically; the Spring Boot app reads the
# same keys because application.yml maps each one to a ${VAR:default} placeholder.
# ---------------------------------------------------------------------------

# ---- Application ----
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local-mysql
APP_LOG_LEVEL=INFO

# ---- Database (PostgreSQL canonical: Docker locally, AWS RDS in production) ----
DB_URL=jdbc:postgresql://localhost:5432/orderdb
DB_USERNAME=orderuser
DB_PASSWORD=orderpass
DB_DRIVER=org.postgresql.Driver
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
JPA_DDL_AUTO=update

# ---- Database (MySQL 8 alternative for machines without Docker) ----
# SPRING_PROFILES_ACTIVE=local-mysql
# DB_URL=jdbc:mysql://localhost:3306/orderdb?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=change-me
# DB_DRIVER=com.mysql.cj.jdbc.Driver

# ---- RabbitMQ ----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=orderuser
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/
RABBITMQ_PREFETCH=20
RABBITMQ_LISTENER_CONCURRENCY=5
RABBITMQ_LISTENER_MAX_CONCURRENCY=10

# ---- Bounded worker pool ----
ORDER_CORE_POOL_SIZE=10
ORDER_MAX_POOL_SIZE=10
ORDER_QUEUE_CAPACITY=100
ORDER_KEEP_ALIVE_SECONDS=60
ORDER_AWAIT_TERMINATION_SECONDS=30

# ---- Bounded retry ----
ORDER_MAX_RETRY_ATTEMPTS=3
ORDER_RETRY_BACKOFF_MS=300

# ---- Messaging transport: rabbitmq | in-process ----
ORDER_MESSAGING_TRANSPORT=rabbitmq
ORDER_EXCHANGE=order.exchange
ORDER_QUEUE=order.queue
ORDER_ROUTING_KEY=order.routing-key
ORDER_DLX=order.dlx
ORDER_DLQ=order.dlq
ORDER_DLQ_ROUTING_KEY=order.dlq.routing-key

# ---- Docker Compose service credentials ----
POSTGRES_DB=orderdb
POSTGRES_USER=orderuser
POSTGRES_PASSWORD=change-me
RABBITMQ_DEFAULT_USER=orderuser
RABBITMQ_DEFAULT_PASS=change-me

# ---- Frontend (Vite) ----
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
